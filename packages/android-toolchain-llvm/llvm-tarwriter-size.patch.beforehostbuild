+// Ustar stores sizes as eleven octal digits followed by a null byte.
+static void writeTarSize(char (&Field)[12], size_t Size) {
+  if (Size > 077777777777ULL)
+    report_fatal_error("file too large for Ustar size field");
+  for (size_t I = 0; I < sizeof(Field) - 1; ++I) {
+    Field[sizeof(Field) - 2 - I] = static_cast<char>('0' + (Size & 7));
+    Size >>= 3;
+  }
+  Field[sizeof(Field) - 1] = '\0';
+}
